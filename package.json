{
  "name": "@kontourai/ui",
  "version": "1.16.0",
  "description": "Framework-agnostic console tokens and shared UI primitives for Kontour console products.",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && tsc -p tsconfig.elements.json",
    "prepack": "npm run build",
    "check:exports": "npm run build && node scripts/check-package-exports.mjs",
    "check:surface-parity": "node scripts/check-surface-parity.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:readiness": "node scripts/check-readiness.mjs",
    "check:pack": "node scripts/check-package-contents.mjs",
    "test:browser": "playwright test",
    "check:explorer": "node scripts/check-explorer.mjs",
    "check:design": "node scripts/generate-design-md.mjs --check",
    "check:trust-state-css": "node scripts/generate-trust-state-css.mjs --check",
    "check": "npm run check:tokens && npm run check:contrast && npm run test:unit && npm run check:design && npm run check:trust-state-css && npm run check:exports && npm run check:surface-parity && npm run check:readiness && npm run check:explorer",
    "verify": "npm run check && npm run check:pack && npm run test:browser",
    "workflow:sidecar": "flow-agents-workflow-sidecar",
    "workflow:validate-artifacts": "flow-agents-validate-artifacts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\""
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@kontourai/flow-agents": "5.5.0",
    "@kontourai/surface": "3.2.0",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.7",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.5",
    "postcss-value-parser": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "exports": {
    "./tokens": "./tokens/index.css",
    "./tokens.css": "./tokens/tokens.css",
    "./themes.css": "./tokens/themes.css",
    "./fonts.css": "./tokens/fonts.css",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/styles.css": "./react/styles.css",
    "./trust-state": {
      "types": "./dist/react/trust-states.d.ts",
      "import": "./dist/react/trust-states.js"
    },
    "./trust-state.css": "./react/trust-state.css",
    "./icons/*": "./icons/*",
    "./elements": {
      "types": "./dist/elements/elements/src/index.d.ts",
      "import": "./dist/elements/elements/src/index.js"
    },
    "./contrast": {
      "types": "./contrast/index.d.ts",
      "import": "./contrast/index.js"
    }
  },
  "files": [
    "contrast/",
    "dist/",
    "docs/",
    "elements/",
    "icons/",
    "react/styles.css",
    "react/trust-state.css",
    "tokens/",
    "README.md",
    "DESIGN.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kontourai/ui.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0"
}
